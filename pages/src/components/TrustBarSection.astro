---
---

<section class="trustbar-section" aria-label="项目数据">
  <div class="trustbar-container">
    <div class="trustbar-grid">
      <div class="trust-item">
        <a class="trust-link" href="/smart-servlet/guides/release_note/">
          <strong class="trust-value"><span id="trustDownloadCount">—</span></strong>
          <span class="trust-label">GitHub 累计下载（实时）</span>
        </a>
      </div>
      <div class="trust-item">
        <strong class="trust-value"><span id="trustReleaseCount">—</span></strong>
        <span class="trust-label">累计发布版本（实时）</span>
      </div>
    </div>
  </div>
</section>

<style>
  .trustbar-section {
    padding: var(--space-8) var(--space-4);
    background: var(--bg-primary);
  }

  .trustbar-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .trustbar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: 560px;
    margin: 0 auto;
  }

  .trust-item {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    text-align: center;
  }

  .trust-item + .trust-item {
    border-left: 1px solid var(--border-color);
  }

  .trust-link {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    text-decoration: none;
  }

  .trust-value {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .trust-link:hover .trust-value {
    color: var(--accent-primary);
  }

  .trust-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.5;
  }

</style>

<script>
  // 匿名调用 GitHub API(60 次/小时/客户端,足够计数场景使用)
  try {
    const response = await fetch('https://api.github.com/repos/smartboot/smart-servlet/releases');
    const releases = await response.json();

    if (Array.isArray(releases) && releases.length > 0) {
      const totalReleaseCount = releases.length;

      // 计算下载总量
      let totalDownloadCount = 0;
      releases.forEach((release) => {
        (release.assets || []).forEach((asset) => {
          totalDownloadCount += asset.download_count || 0;
        });
      });

      const counter = document.getElementById('trustDownloadCount');
      const totalReleaseCounter = document.getElementById('trustReleaseCount');
      const duration = 2000;
      const startTime = performance.now();

      const easeOutQuad = t => t * (2 - t);

      const animate = (currentTime) => {
        const elapsed = currentTime - startTime;
        if (elapsed < duration) {
          const progress = elapsed / duration;
          counter.textContent = Math.floor(easeOutQuad(progress) * totalDownloadCount).toLocaleString();
          totalReleaseCounter.textContent = Math.floor(easeOutQuad(progress) * totalReleaseCount).toLocaleString();
          requestAnimationFrame(animate);
        } else {
          counter.textContent = totalDownloadCount.toLocaleString();
          totalReleaseCounter.textContent = totalReleaseCount.toLocaleString();
        }
      };

      requestAnimationFrame(animate);
    }
  } catch (e) {
    // 网络异常或限流时保持占位符,不报错
  }
</script>
