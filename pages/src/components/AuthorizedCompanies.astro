---
interface Company {
  companyName: string;
  creditCode?: string;
  serviceSince: string;
  serviceUntil: string;
  serviceNo?: string;
  level?: string;
}

interface Props {
  companies?: Company[];
}

const { companies = [] } = Astro.props as Props;
const now = new Date();

function isActive(date: string) {
  return new Date(date).getTime() >= now.getTime();
}
---

{companies.length === 0 ? (
  <div class="empty-state">
    <div class="empty-mark"></div>
    <h3>暂无公开的服务客户信息</h3>
    <p>是否公示由企业自愿选择，我们将在征得企业同意后持续更新名录。<br />未公示不代表未合作。</p>
  </div>
) : (
  <div class="companies">
    {companies.map((company) => (
      <div class="company-card">
        <div class="card-header">
          <div class="card-company">{company.companyName}</div>
          <span class="card-badge">{company.level ?? '企业服务订阅'}</span>
        </div>
        <div class="card-meta">
          <span>服务编号：{company.serviceNo ?? '—'}</span>
          <span>服务周期：{company.serviceSince} 至 {company.serviceUntil}</span>
          <span class={isActive(company.serviceUntil) ? 'status-active' : 'status-expired'}>
            {isActive(company.serviceUntil) ? '服务中' : '已到期'}
          </span>
        </div>
      </div>
    ))}
  </div>
)}

<style>
.companies { display:grid; gap:1rem; margin:2rem 0; }
.company-card { width:100%; padding:1.5rem; border:1px solid var(--sl-color-gray-5); border-radius:20px; background:var(--sl-color-bg); }
.card-header { display:flex; justify-content:space-between; gap:1rem; align-items:center; }
.card-company { font-size:1.15rem; font-weight:650; line-height:1.5; }
.card-badge { padding:0.25rem 0.75rem; border:1px solid var(--sl-color-gray-5); border-radius:999px; font-size:0.8rem; color:var(--sl-color-gray-3); white-space:nowrap; }
.card-meta { display:flex; flex-wrap:wrap; gap:0.75rem 1.5rem; margin-top:1.25rem; font-size:0.9rem; color:var(--sl-color-gray-3); }
.status-active { color:var(--sl-color-accent); }
.status-expired { opacity:0.7; }

.empty-state { padding:4rem 2rem; border:1px dashed var(--sl-color-gray-5); border-radius:24px; background:var(--sl-color-bg); text-align:center; }
.empty-mark { width:36px; height:36px; margin:0 auto; border:2px solid var(--sl-color-gray-4); border-radius:50%; }
.empty-state h3 { margin:1rem 0 0.5rem; }
.empty-state p { color: var(--sl-color-gray-3); line-height:1.8; }

@media (max-width:640px) {
  .card-header, .card-meta { flex-direction:column; align-items:flex-start; }
}
</style>
