---
// TCK 演进数据:与 guides/tck_report.mdx 历次记录一致
const tckPoints = [
  { v: 'v2.0', rate: '88.4%', y: 204 },
  { v: 'v2.1', rate: '94.5%', y: 113 },
  { v: 'v2.2', rate: '98.3%', y: 56 },
  { v: 'v2.3', rate: '99.5%', y: 38 },
  { v: 'v2.4', rate: '99.7%', y: 35 },
  { v: 'v2.8', rate: '99.8%', y: 33 },
  { v: 'v3.3', rate: '99.8%', y: 33 },
  { v: 'v4.0', rate: '100%', y: 30 },
];
---

<section class="quality-pledge-section" id="quality">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">质量证据</span>
      <h2 class="section-title">两年，从 88.4% 到 100%</h2>
      <p class="section-description">
        自 2024 年引入 Servlet TCK 起，每个版本公开发布测试报告
      </p>
    </div>

    <div class="tck-card reveal">
      <div class="tck-summary">
        <div class="tck-summary-item">
          <strong class="stat-value stat-accent">1732</strong>
          <span class="stat-label">当前版本 TCK 用例总数</span>
        </div>
        <div class="tck-summary-item">
          <strong class="stat-value">1732</strong>
          <span class="stat-label">通过用例，全部通过</span>
        </div>
      </div>

      <div class="tck-chart" role="img" aria-label="TCK 通过率从 2024 年 7 月的 88.4% 提升至 2026 年 11 月的 100%">
        <svg viewBox="0 0 720 240" preserveAspectRatio="xMidYMid meet">
          <!-- 网格线与纵轴刻度(88%–100%) -->
          {[
            { v: '88%', y: 210 },
            { v: '90%', y: 180 },
            { v: '92%', y: 150 },
            { v: '94%', y: 120 },
            { v: '96%', y: 90 },
            { v: '98%', y: 60 },
            { v: '100%', y: 30 },
          ].map((g) => (
            <g>
              <line class="grid-line" x1="60" y1={g.y} x2="700" y2={g.y} />
              <text class="axis-label" x="46" y={g.y + 3} text-anchor="end">{g.v}</text>
            </g>
          ))}

          <!-- 演进折线 -->
          <polyline class="tck-line" points="60,204 151,113 243,56 334,38 426,35 517,33 609,33 700,30" />

          <!-- 数据点与横轴标签 -->
          {tckPoints.map((p, i) => {
            const x = 60 + i * (640 / 7);
            return (
              <g>
                <circle class="tck-dot" cx={x} cy={p.y} r="4" />
                <text class="axis-label" x={x} y="228" text-anchor="middle">{p.v}</text>
              </g>
            );
          })}

          <!-- 首末点数值标注 -->
          <text class="point-label" x="60" y="192" text-anchor="start">88.4%</text>
          <text class="point-label point-label-end" x="700" y="18" text-anchor="end">100%</text>
        </svg>
      </div>

      <div class="tck-footnote">
        历次通过率记录公开可查，完整用例明细可在
        <a href="./guides/tck_report/">TCK 测试报告</a>
        页下载复核
      </div>
    </div>

    <!-- 项目里程碑 -->
    <div class="milestone reveal" aria-label="项目里程碑">
      <div class="milestone-track"></div>
      <ol class="milestone-list">
        <li class="milestone-item">
          <span class="milestone-dot"></span>
          <strong class="timeline-value">2020-11</strong>
          <span>立项，起步于 Servlet 3.1</span>
        </li>
        <li class="milestone-item">
          <span class="milestone-dot"></span>
          <strong class="timeline-value">2023</strong>
          <span>引入 Servlet TCK 体系化测试</span>
        </li>
        <li class="milestone-item">
          <span class="milestone-dot"></span>
          <strong class="timeline-value">2024</strong>
          <span>1.0 / 2.0 发布，升级 Servlet 6.0；年末迁移至 Feat 平台</span>
        </li>
        <li class="milestone-item">
          <span class="milestone-dot"></span>
          <strong class="timeline-value">2025</strong>
          <span>3.0 发布</span>
        </li>
        <li class="milestone-item">
          <span class="milestone-dot"></span>
          <strong class="timeline-value">2026-11</strong>
          <span>4.0 发布，TCK 100% 通过</span>
        </li>
      </ol>
    </div>

  </div>
</section>

<style>
  .quality-pledge-section {
    padding: var(--space-16) var(--space-4);
    background: var(--bg-primary);
    position: relative;
  }

  .quality-pledge-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-color), transparent);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-primary);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 var(--space-4);
    letter-spacing: -0.02em;
  }

  .section-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* TCK 演进卡:摘要 + 折线图 + 脚注 */
  .tck-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    margin-bottom: var(--space-6);
    display: grid;
    gap: var(--space-8);
  }

  :root[data-theme="light"] .tck-card {
    box-shadow: var(--shadow-md);
  }

  .tck-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .tck-summary-item {
    display: grid;
    gap: var(--space-1);
    text-align: center;
    justify-items: center;
  }

  .tck-summary-item + .tck-summary-item {
    border-left: 1px solid var(--border-color);
  }

  .tck-chart {
    overflow-x: auto;
  }

  .tck-chart svg {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
    color: var(--text-muted);
  }

  .grid-line {
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .axis-label {
    fill: var(--text-muted);
    font-size: 10px;
    font-family: var(--font-mono);
  }

  .tck-line {
    fill: none;
    stroke: var(--accent-primary);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tck-dot {
    fill: var(--bg-primary);
    stroke: var(--accent-primary);
    stroke-width: 2;
  }

  .point-label {
    fill: var(--text-secondary);
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .point-label-end {
    fill: var(--accent-primary);
    font-size: 13px;
    font-weight: 700;
  }

  .tck-footnote {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .tck-footnote a {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .tck-footnote a:hover { text-decoration: underline; }

  /* 项目里程碑:横向时间线(区块末尾元素,无需底边距) */
  .milestone {
    padding: var(--space-6) 0;
  }

  .milestone-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
    position: relative;
  }

  .milestone-track {
    position: absolute;
    top: 5px;
    left: 2%;
    right: 2%;
    height: 1px;
    background: var(--border-color);
  }

  .milestone-item {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    text-align: center;
    position: relative;
    padding-top: var(--space-4);
  }

  .milestone-dot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    background: var(--bg-primary);
    border: 2px solid var(--accent-primary);
  }

  .milestone-item .timeline-value {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
  }

  .milestone-item span:not(.milestone-dot) {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 180px;
  }

  @media (max-width: 900px) {
    .milestone-list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .milestone-track,
    .milestone-dot {
      display: none;
    }

    .milestone-item {
      padding-top: 0;
      justify-items: start;
      text-align: left;
    }

    .milestone-item span:not(.milestone-dot) {
      max-width: 100%;
    }
  }


