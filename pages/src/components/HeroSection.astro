---
---

<section class="hero-section">
  <div class="hero-background">
    <div class="gradient-orb orb-1"></div>
    <div class="gradient-orb orb-2"></div>
    <div class="grid-pattern"></div>
  </div>

  <div class="hero-container">
    <div class="hero-content">
      <!-- Badge -->
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span class="badge-spec">Jakarta Servlet 6.1 · Java 17+</span>
        <span class="badge-divider" aria-hidden="true"></span>
        <span class="badge-text">开源免费商用 · Apache-2.0</span>
      </div>

      <!-- Title -->
      <h1 class="hero-title">
        <span class="title-line">smart-servlet</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle">
        把 Spring Boot 里的 Tomcat，换成初始内存仅 <span class="subtitle-accent">12MB</span> 的 smart-servlet
      </p>

      <!-- Description -->
      <p class="hero-description">
        只改 pom.xml 依赖 · Tomcat / Undertow 直接替代 · 兼容 Spring Boot 3.x / Spring Cloud / Shiro
      </p>

      <!-- Stat strip -->
      <dl class="hero-stats">
        <div class="hero-stat">
          <dt class="stat-label">Servlet TCK 通过率</dt>
          <dd class="stat-value">100%</dd>
        </div>
        <div class="hero-stat">
          <dt class="stat-label">QPS（wrk 压测）</dt>
          <dd class="stat-value">42W</dd>
        </div>
        <div class="hero-stat">
          <dt class="stat-label">初始 Heap 内存</dt>
          <dd class="stat-value">12MB</dd>
        </div>
        <div class="hero-stat">
          <dt class="stat-label">业务代码改动</dt>
          <dd class="stat-value">0 行</dd>
        </div>
      </dl>

      <!-- Actions -->
      <div class="hero-actions">
        <a href="./guides/install/" class="btn btn-primary">
          <span>5 分钟替换 Tomcat</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#performance" class="btn btn-secondary">
          <span>查看性能对比数据</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Wave -->
  <div class="hero-wave">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,60 C240,120 480,0 720,60 C960,120 1200,0 1440,60 L1440,120 L0,120 Z" fill="var(--bg-primary)"/>
    </svg>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: var(--space-20) var(--space-4) var(--space-16);
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
  }

  /* Background Effects */
  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.10;
    animation: float 20s ease-in-out infinite;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: var(--accent-primary);
    top: -200px;
    right: -100px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 400px;
    height: 400px;
    background: var(--accent-secondary);
    bottom: 100px;
    left: -100px;
    animation-delay: -7s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -30px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
  }

  .grid-pattern {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(rgba(59, 130, 246, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59, 130, 246, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
  }

  /* Container */
  .hero-container {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    text-align: center;
    align-items: center;
    padding: var(--space-4) 0;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    animation: fadeInUp 0.6s ease-out;
  }

  .badge-spec {
    color: var(--text-secondary);
  }

  .badge-divider {
    width: 1px;
    height: 12px;
    background: var(--border-color);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
    border-radius: var(--radius-full);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }

  /* Title */
  .hero-title {
    font-size: clamp(3rem, 10vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    margin: 0;
    letter-spacing: -0.04em;
    animation: fadeInUp 0.6s ease-out 0.1s both;
  }

  .title-line {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Subtitle */
  .hero-subtitle {
    font-size: clamp(1.125rem, 2.25vw, 1.375rem);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.5;
    margin: 0;
    text-wrap: balance;
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }

  .subtitle-accent {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Description */
  .hero-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }

  /* Stat strip:数字 + 标签,以分隔线分区 */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: var(--space-2) 0 0;
    padding: var(--space-5) var(--space-8);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    max-width: 640px;
    width: 100%;
    animation: fadeInUp 0.6s ease-out 0.4s both;
  }

  .hero-stat {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    text-align: center;
    padding: 0 var(--space-2);
  }

  .hero-stat + .hero-stat {
    border-left: 1px solid var(--border-color);
  }

  .hero-stat dd {
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) 0;
      padding: var(--space-5) var(--space-4);
    }

    .hero-stat:nth-child(3) {
      border-left: none;
    }
  }

  /* Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    animation: fadeInUp 0.6s ease-out 0.6s both;
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: 500;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.35);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.45);
  }

  .btn-secondary {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-secondary:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  /* Wave */
  .hero-wave {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    z-index: 1;
  }

  .hero-wave svg {
    width: 100%;
    height: 100%;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
