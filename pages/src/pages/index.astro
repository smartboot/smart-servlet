---
import Navigation from '../components/Navigation.astro';
import HeroSection from '../components/HeroSection.astro';
import MigrationSection from '../components/MigrationSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import PerformanceSection from '../components/PerformanceSection.astro';
import QualityPledgeSection from '../components/QualityPledgeSection.astro';
import LicensingSection from '../components/LicensingSection.astro';
import TrustBarSection from '../components/TrustBarSection.astro';
import ClosingCtaSection from '../components/ClosingCtaSection.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>smart-servlet - 轻量级 Jakarta Servlet 6.1 容器</title>
  <meta name="description" content="smart-servlet 是基于 Jakarta Servlet 6.1 的轻量级高性能 Servlet 容器，可作为 Tomcat / Undertow 的替代方案，无缝运行 Spring Boot 应用。">
  <meta name="keywords" content="smart-servlet,Servlet 容器,Tomcat 替代,轻量级,Jakarta Servlet 6.1,Spring Boot,Java,国产中间件,信创">
  <script is:inline>
    // Initialize theme before page renders
    (function() {
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <ThemeToggle />
  <Navigation />
  <main class="landing-page">
    <HeroSection />
    <TrustBarSection />
    <MigrationSection />
    <FeaturesSection />
    <PerformanceSection />
    <QualityPledgeSection />
    <LicensingSection />
    <ClosingCtaSection />
  </main>
  <Footer />

  <script>
    // Scroll-reveal:一次性触发的入场动效
    (function () {
      const els = document.querySelectorAll('.reveal');
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('revealed'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
      );
      els.forEach((el) => io.observe(el));
    })();
  </script>
</body>
</html>

<style is:global>
  /* CSS Variables - Dark theme (default) */
  :root {
    /* Base colors */
    --sl-color-black: #0f172a;
    --sl-color-white: #f8fafc;
    --sl-color-gray-1: #e2e8f0;
    --sl-color-gray-2: #cbd5e1;
    --sl-color-gray-3: #94a3b8;
    --sl-color-gray-4: #64748b;
    --sl-color-gray-5: #475569;
    --sl-color-gray-6: #1e293b;
    --sl-color-text: #f1f5f9;
    
    /* Semantic colors */
    --bg-primary: #0f172a;
    --bg-secondary: #1e293b;
    --bg-tertiary: #0b1221;
    --bg-card: rgba(30, 41, 59, 0.6);
    --bg-card-hover: rgba(30, 41, 59, 0.85);
    --border-color: rgba(148, 163, 184, 0.12);
    --border-hover: rgba(59, 130, 246, 0.4);
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --accent-primary: #3b82f6;
    --accent-secondary: #8b5cf6;
    --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%);
    --code-bg: rgba(15, 23, 42, 0.8);
    
    /* Spacing System - 8px base */
    --space-1: 0.25rem;   /* 4px */
    --space-2: 0.5rem;    /* 8px */
    --space-3: 0.75rem;   /* 12px */
    --space-4: 1rem;      /* 16px */
    --space-5: 1.25rem;   /* 20px */
    --space-6: 1.5rem;    /* 24px */
    --space-8: 2rem;      /* 32px */
    --space-10: 2.5rem;   /* 40px */
    --space-12: 3rem;     /* 48px */
    --space-16: 4rem;     /* 64px */
    --space-20: 5rem;     /* 80px */
    --space-24: 6rem;     /* 96px */
    
    /* Typography Scale */
    --text-xs: 0.75rem;   /* 12px */
    --text-sm: 0.875rem;  /* 14px */
    --text-base: 1rem;    /* 16px */
    --text-lg: 1.125rem;  /* 18px */
    --text-xl: 1.25rem;   /* 20px */
    --text-2xl: 1.5rem;   /* 24px */
    --text-3xl: 1.875rem; /* 30px */
    --text-4xl: 2.25rem;  /* 36px */
    --text-5xl: 3rem;     /* 48px */
    --text-6xl: 3.75rem;  /* 60px */
    
    /* Border Radius */
    --radius-sm: 0.375rem;  /* 6px */
    --radius-md: 0.5rem;    /* 8px */
    --radius-lg: 0.75rem;   /* 12px */
    --radius-xl: 1rem;      /* 16px */
    --radius-2xl: 1.25rem;  /* 20px */
    --radius-full: 9999px;
    
    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.1);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.15);
    --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.2);
    --shadow-xl: 0 20px 48px rgba(0, 0, 0, 0.25);
    --shadow-glow: 0 0 40px rgba(59, 130, 246, 0.15);
    
    /* Transitions */
    --transition-fast: 150ms ease;
    --transition-base: 250ms ease;
    --transition-slow: 350ms ease;

    /* Monospace stack(代码/数字场景统一) */
    --font-mono: 'SF Mono', Monaco, 'Cascadia Code', monospace;
  }

  /* Light theme */
  :root[data-theme="light"] {
    --sl-color-black: #ffffff;
    --sl-color-white: #0f172a;
    --sl-color-gray-1: #334155;
    --sl-color-gray-2: #475569;
    --sl-color-gray-3: #64748b;
    --sl-color-gray-4: #94a3b8;
    --sl-color-gray-5: #cbd5e1;
    --sl-color-gray-6: #f1f5f9;
    --sl-color-text: #1e293b;
    
    --bg-primary: #f8fafc;
    --bg-secondary: #f1f5f9;
    --bg-tertiary: #e2e8f0;
    --bg-card: rgba(255, 255, 255, 0.85);
    --bg-card-hover: rgba(255, 255, 255, 1);
    --border-color: rgba(148, 163, 184, 0.2);
    --border-hover: rgba(59, 130, 246, 0.5);
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --text-muted: #64748b;
    --code-bg: #1e293b;
    
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.12);
    --shadow-xl: 0 20px 48px rgba(0, 0, 0, 0.15);
    --shadow-glow: 0 0 40px rgba(59, 130, 246, 0.1);
  }

  /* Reset and base styles */
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    transition: background-color var(--transition-base), color var(--transition-base);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .landing-page {
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Section base styles */
  section {
    position: relative;
  }

  /* Section anchor offset for fixed nav */
  section[id] {
    scroll-margin-top: 80px;
  }

  /* Smooth transitions for theme changes - only specific properties */
  .theme-transition {
    transition: background-color var(--transition-base),
                border-color var(--transition-base),
                color var(--transition-base);
  }

  /* Selection color */
  ::selection {
    background: rgba(59, 130, 246, 0.3);
    color: var(--text-primary);
  }

  /* Scrollbar styling */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--bg-secondary);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--text-muted);
    border-radius: var(--radius-full);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--text-secondary);
  }

  /* ===== 首页公共层:统计数字/入场动效/共享关键帧 ===== */

  /* 数字统一等宽数字,避免跳动 */
  .stat-value,
  .stat-label,
  .metric-value,
  .bar-value,
  .trust-item strong,
  .tag-value,
  .proof-item strong,
  .timeline-value {
    font-variant-numeric: tabular-nums;
  }

  /* 大数字 + 小标签:Hero / Migration / Performance / Licensing 共用 */
  .stat-value {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .stat-value.stat-accent {
    color: var(--accent-primary);
  }

  .stat-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Scroll-reveal 一次性入场 */
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* 共享关键帧(各组件亦可保留自己的局部定义) */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 无障碍:用户偏好减少动态效果时,动效全部静止 */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .gradient-orb,
    .badge-dot {
      animation: none !important;
    }
  }
</style>
